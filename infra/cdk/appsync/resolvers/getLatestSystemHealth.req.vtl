{
  "version": "2017-02-28",
  "operation": "Scan",
  "limit": 50,
  "filter": {
    "expression": "#ts > :cutoff",
    "expressionNames": {
      "#ts": "timestamp"
    },
    "expressionValues": {
      ":cutoff": $util.dynamodb.toDynamoDBJson($util.time.nowEpochMilliSeconds() - 600000)
    }
  }
}
