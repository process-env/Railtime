## Return the latest pre-aggregated SYSTEM_HEALTH record
#set($items = $ctx.result.items)
#if($items.isEmpty())
  $util.toJson(null)
#else
  #set($item = $items[0])
  #set($feedGroups = [])
  #if($item.feedGroupData)
    #set($feedGroups = $util.parseJson($item.feedGroupData))
  #end
  $util.toJson({
    "timestamp": $item.timestamp,
    "activeTrains": $item.trainCount,
    "feedGroups": $feedGroups,
    "alertCount": $util.defaultIfNull($item.alertCount, 0)
  })
#end
