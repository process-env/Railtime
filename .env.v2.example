# Railtime v2 Environment Variables

# MTA API Key (required for feed ingestion)
MTA_API_KEY=

# Neo4j (defaults for docker-compose.v2.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=railtime_dev

# Redis (defaults for docker-compose.v2.yml)
REDIS_URL=redis://localhost:6379

# WebSocket Server (set in Vercel for production)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# AWS Analytics (DynamoDB metrics persistence)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_METRICS=railtime-metrics
DYNAMODB_TABLE_EVENTS=railtime-events
DYNAMODB_TABLE_ROLLUPS=railtime-rollups

# Existing env vars (carry forward)
DATABASE_URL=
TOMTOM_ADMIN_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
